, "groupIds": [], "frameId": "zxb5ch4efzuoq2f2", "roundness": null, "seed": 1963908619, "version": 1, "versionNonce": 739014846, "isDeleted": false, "boundElements": [], "updated": 1794157960932, "link": null, "locked": false, "text": "flow", "fontSize": 34, "fontFamily": 1, "textAlign": "right", "verticalAlign": "top", "containerId": null, "originalText": "flow", "autoResize": true, "lineHeight": 1.25}, {"id": "2q63dtn8o4t9xa8i", "type": "frame", "x": 0, "y": 24120, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "zxb5ch4efzuoq2f2", "roundness": null, "seed": 315743632, "version": 1, "versionNonce": 480504522, "isDeleted": false, "boundElements": [], "updated": 1794157960932, "link": null, "locked": false, "name": "19 Three shapes"}, {"id": "oibk5ka8qxyn4aqp", "type": "text", "x": 2000, "y": 24120, "width": 876.0, "height": 552.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1392573793, "version": 1, "versionNonce": 579130950, "isDeleted": false, "boundElements": [], "updated": 1794157960937, "link": null, "locked": false, "text": "Notes\n\n[20:30 \u00b7 1.5 min]\nSAY:\nShape one: the input sits upstream of the target.\nThe target was made from it. Stop.\n\nShape two: the input sits downstream.\nThe input was made from the target. Also stop.\nThat's the true circular case. Predicting the parent from its child.\n\nShape three: two inputs share a parent.\nThey're related to each other. Sometimes fine. Always worth a look.\n\nThat's all. Three shapes.\n\nNEXT: now we write the graph down.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[20:30 \u00b7 1.5 min]\nSAY:\nShape one: the input sits upstream of the target.\nThe target was made from it. Stop.\n\nShape two: the input sits downstream.\nThe input was made from the target. Also stop.\nThat's the true circular case. Predicting the parent from its child.\n\nShape three: two inputs share a parent.\nThey're related to each other. Sometimes fine. Always worth a look.\n\nThat's all. Three shapes.\n\nNEXT: now we write the graph down.", "autoResize": true, "lineHeight": 1.25}, {"id": "0qxuujb6t5aof43n", "type": "text", "x": 110, "y": 24200, "width": 804.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "2q63dtn8o4t9xa8i", "roundness": null, "seed": 2079475108, "version": 1, "versionNonce": 583077840, "isDeleted": false, "boundElements": [], "updated": 1794157960938, "link": null, "locked": false, "text": "Three shapes to look for", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Three shapes to look for", "autoResize": true, "lineHeight": 1.25}, {"id": "h639haul8my7ebmt", "type": "rectangle", "x": 110, "y": 24320, "width": 540, "height": 760, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "2q63dtn8o4t9xa8i", "roundness": {"type": 3}, "seed": 326441017, "version": 1, "versionNonce": 496156402, "isDeleted": false, "boundElements": [], "updated": 1794157960938, "link": null, "locked": false}, {"id": "k2whmyrmqzh0oqy0", "type": "text", "x": 273.5, "y": 24350, "width": 213.0, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "2q63dt