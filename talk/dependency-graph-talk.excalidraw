0, "y": 880, "width": 312.0, "height": 55.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "ujzde8gxd6ncf10e", "roundness": null, "seed": 364725392, "version": 1, "versionNonce": 682281554, "isDeleted": false, "boundElements": [], "updated": 1794157960787, "link": null, "locked": false, "text": "Kayode Adeniyi", "fontSize": 44, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Kayode Adeniyi", "autoResize": true, "lineHeight": 1.25}, {"id": "kibj3j4wj99ibag7", "type": "text", "x": 631.5, "y": 950, "width": 657.0, "height": 40.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "ujzde8gxd6ncf10e", "roundness": null, "seed": 598077321, "version": 1, "versionNonce": 1863197322, "isDeleted": false, "boundElements": [], "updated": 1794157960787, "link": null, "locked": false, "text": "JS Monthly London  \u00b7  12 November 2026", "fontSize": 32, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "JS Monthly London  \u00b7  12 November 2026", "autoResize": true, "lineHeight": 1.25}, {"id": "mnbqns6puq80idw3", "type": "frame", "x": 0, "y": 1340, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "ujzde8gxd6ncf10e", "roundness": null, "seed": 1806584668, "version": 1, "versionNonce": 561623934, "isDeleted": false, "boundElements": [], "updated": 1794157960787, "link": null, "locked": false, "name": "02 Seen this?"}, {"id": "8j76b2lajlj4h9du", "type": "text", "x": 2000, "y": 1340, "width": 776.0, "height": 487.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2072265938, "version": 1, "versionNonce": 455736474, "isDeleted": false, "boundElements": [], "updated": 1794157960791, "link": null, "locked": false, "text": "Notes\n\n[0:30 \u00b7 1.5 min]\n[ASK] Hands up if you've seen this warning.\n[Wait. Most hands go up. Laugh with them.]\n\nSAY:\na.js imports b.js. b.js imports a.js. A loop.\nAnd our bundler catches it for us. We don't go looking.\nThe tooling knows what depends on what, so it can warn us.\n\nHold on to that idea: tools can only warn us about loops\nwhen somebody has written the dependencies down.\n\nNEXT: now something from outside code.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[0:30 \u00b7 1.5 min]\n[ASK] Hands up if you've seen this warning.\n[Wait. Most hands go up. Laugh with them.]\n\nSAY:\na.js imports b.js. b.js imports a.js. A loop.\nAnd our bundler catches it for us. We don't go looking.\nThe tooling knows what depends on what, so it can warn us.\n\nHold on to that idea: tools can only warn us about loops\nwhen somebody has written the dependencies down.\n\nNEXT: now something from outside code.", "autoResize": true, "lineHeight": 1.25}, {"id": "9dpmrcg629be2u66", "type": "text", "x": 110, "y": 1420, "width": 397.0, "height": 100.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "mnbqns6puq80idw3", "roundness": null, "seed": 856430244, "version": 1, "versionNonce": 1190502837, "isDeleted": false, "boundElements": [], "updated": 1794157960791, "link": null, "locked": false, "text": "Seen this?", "fontSize": 80, "fontFamily": 1, "textAlign": "left", 