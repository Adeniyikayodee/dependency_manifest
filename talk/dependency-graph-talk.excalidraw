s signal"}, {"id": "exkxkfva4tjqggph", "type": "text", "x": 2000, "y": 12060, "width": 796.0, "height": 520.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 657454727, "version": 1, "versionNonce": 2130857125, "isDeleted": false, "boundElements": [], "updated": 1794157960868, "link": null, "locked": false, "text": "Notes\n\n[10:00 \u00b7 1.5 min]\nSAY:\nLeft: the leak. A thin, perfect line.\n\nRight: one column called internet access.\nCDC ships it in the same file, but it's not part of the score.\nIt still relates to vulnerability. It scores 0.384.\n\nThat messy cloud is what a real relationship looks like.\nReal life is noisy.\n\nTAKEAWAY: when a score looks too clean, get suspicious.\n\nNEXT: and here's the worst part.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[10:00 \u00b7 1.5 min]\nSAY:\nLeft: the leak. A thin, perfect line.\n\nRight: one column called internet access.\nCDC ships it in the same file, but it's not part of the score.\nIt still relates to vulnerability. It scores 0.384.\n\nThat messy cloud is what a real relationship looks like.\nReal life is noisy.\n\nTAKEAWAY: when a score looks too clean, get suspicious.\n\nNEXT: and here's the worst part.", "autoResize": true, "lineHeight": 1.25}, {"id": "r88hu3pk8c6qxmsz", "type": "text", "x": 110, "y": 12140, "width": 779.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e93g9hkz3ccc6g0i", "roundness": null, "seed": 873846716, "version": 1, "versionNonce": 545947692, "isDeleted": false, "boundElements": [], "updated": 1794157960868, "link": null, "locked": false, "text": "What each on