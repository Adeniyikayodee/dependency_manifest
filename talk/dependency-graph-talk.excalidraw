: 25460, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "2q63dtn8o4t9xa8i", "roundness": null, "seed": 295628123, "version": 1, "versionNonce": 916565167, "isDeleted": false, "boundElements": [], "updated": 1794157960940, "link": null, "locked": false, "name": "20 Step 1. Write it down"}, {"id": "y1tx7x8una9e5emx", "type": "text", "x": 2000, "y": 25460, "width": 908.0, "height": 650.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2030410805, "version": 1, "versionNonce": 60629644, "isDeleted": false, "boundElements": [], "updated": 1794157960945, "link": null, "locked": false, "text": "Notes\n\n[22:00 \u00b7 1.5 min]\nSAY:\nStep one: write it down.\nThink of it as a lock file for data.\n\nOne entry per dataset: what was it made from?\nThis entry says FEMA's social vulnerability is the Census estimate,\nrepublished under a new name.\n\nTwo small extras make it honest.\nEach box says what kind of number it is:\ncounted, predicted by a model, or plain arithmetic.\nEach arrow says how sure we are:\ncertain, documented in the agency's method, or just inferred.\n\nPlain YAML. In the repo. Reviewed in pull requests like any other code.\n\nNEXT: quick game.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[22:00 \u00b7 1.5 min]\nSAY:\nStep one: write it down.\nThink of it as a lock file for data.\n\nOne entry per dataset: what was it made from?\nThis entry says FEMA's social vulnerability is the Census estimate,\nrepublished under a new name.\n\nTwo small extras make it honest.\nEach box says what kind of number it is:\ncounted, predicted by a model, or plain arithmetic.\nEach arrow says how sure we are:\ncertain, documented in the agency's method, or just inferred.\n\nPlain YAML. In the repo. Reviewed in pull requests like any other code.\n\nNEXT: quick game.", "autoResize": true, "lineHeight": 1.25}, {"id": "mndu967kixiwm939", "type": "text", "x": 110, "y": 25540, "width": 514.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "6mggwse86h3pxrdp", "roundness": null, "seed": 766215811, "version": 1, "versionNonce": 1453283028, "isDeleted": false, "boundElements": [], "updated": 1794157960945, "link": null, "locked": false, "text": "1.  Write it down", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1.  Write it down", "autoResize": true, "lineHeight": 1.25}, {"id": "eu4ms48ddd3uelwy", "type": "rectangle", "x": 110, "y": 25690, "width": 1060, "height": 340, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "6mggwse86h3pxrdp", "roundness": {"type": 3}, "seed": 1569257536, "version": 1, "versionNonce": 297109469, "isDeleted": false, "boundElements": [], "updated": 1794157960945, "link": null, "locked": false}, {"id": "8n2939r74jnj76fz", "type": "text", "x": 150, "y": 25730, "width": 893.0, "height": 240.0, "angle": 0, "strokeColor": "#e9ecef", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "6mggwse86h3pxrdp", "roundness": null, "seed": 1855814720, "version": 1, "versionNonce": 185084386, "isDeleted": false, "boundElements": [], "updated": 1794157960947, "link": null, "locked": false, "text": "FEMA_NRI.social_vulnerability:\n  measuremen