ed": 1794157960845, "link": null, "locked": false, "text": "[edit: the lab + the project, one line]", "fontSize": 30, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "9uhcpqwm2b2hb5he", "originalText": "[edit: the lab + the project, one line]", "autoResize": true, "lineHeight": 1.25}, {"id": "elz4k2zo7exv7nti", "type": "frame", "x": 0, "y": 8040, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "lcqwd9bdq64dgjua", "roundness": null, "seed": 187501104, "version": 1, "versionNonce": 907870874, "isDeleted": false, "boundElements": [], "updated": 1794157960845, "link": null, "locked": false, "name": "07 Our score"}, {"id": "kx3v3ywuav4vobp3", "type": "text", "x": 2000, "y": 8040, "width": 743.0, "height": 520.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 194912015, "version": 1, "versionNonce": 626329356, "isDeleted": false, "boundElements": [], "updated": 1794157960848, "link": null, "locked": false, "text": "Notes\n\n[6:30 \u00b7 1 min]\n[Let the chart land. Don't talk for 3 seconds.]\n\nSAY:\nThis is real. CDC's Social Vulnerability Index.\n9,041 neighbourhoods in California. Proper cross-validation.\nEvery dot is one neighbourhood. They all sit on the line.\n\nR squared 0.998.\n\n[ASK] Who would ship this?\n[A few hands. Good.]\n\nNEXT: put it next to something we just saw.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[6:30 \u00b7 1 min]\n[Let the chart land. Don't talk for 3 seconds.]\n\nSAY:\nThis is real. CDC's Social Vulnerability Index.\n9,041 neighbourhoods in California. Proper cross-validation.\nEvery dot is one neighbourhood. They all sit on the line.\n\nR squared 0.998.\n\n[ASK] Who would ship this?\n[A few hands. Good.]\n\nNEXT: put it next to something we just saw.", "autoResize": true, "lineHeight": 1.25}, {"id": "jryre6qw7ic9gm1g", "type": "image", "x": 120, "y": 8110, "width": 940.0, "height": 940, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "elz4k2zo7exv7nti", "roundness": null, "seed": 1558688456, "version": 1, "versionNonce": 1209392167, "isDeleted": false, "boundElements": [], "updated": 1794157960849, "link": null, "locked": false, "fileId": "546112462a8b8512f70dd10d88b33687d58e1f65", "status": "saved", "scale": [1, 1], "crop": null}, {"id": "pjetvx6pw9zvdvu4", "type": "text", "x": 1120, "y": 8420, "width": 555.0, "height": 150.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "elz4k2zo7exv7nti", "roundness": null, "seed": 1577479020, "version": 1, "versionNonce": 1045489531, "isDeleted": false, "boundElements": [], "updated": 1794157960850, "link": null, "locked": false, "text": "Our model,\non real CDC data.", "fontSize": 60, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Our model,\non real CDC data.", "autoResize": true, "lineHeight": 1.25}, {"id": "pwjina3z2ztkejtt", "type": "text", "x": 1120, "y": 8640, "width": 545.0, "height": 90.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "elz4k2zo7exv7nti", "roundness": null, "seed": 1082837081, "version": 1, "versionNonce": 1462295485, "isDeleted": false, "boundElements": [], "updated": 1794157960851, "link": null, "locked": false, "text": "Almost perfect.", "fontSize": 72, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Almost perfect.", "autoResize": true, "lineHeight": 1.25}, {"id": "emfltw3w1e5ulrq8", "type": "frame", "x": 0, "y": 9380, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "elz4k2zo7exv7nti", "roundness": null, "seed": 99093477, "version": 1, "versionNonce": 706801806, "isDeleted": false, "boundElements": [], "updated": 1794157960851, "link": null, "locked": false, "name": "08 Look familiar?"}, {"id": "rpbndz2ms6gmpdid", "type": "text", "x": 2000, "y": 9380, "width": 589.0, "height": 520.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 340626989, "version": 1, "versionNonce": 315442769, "isDeleted": false, "boundElements": [], "updated": 1794157960853, "link": null, "locked": false, "text": "Notes\n\n[7:30 \u00b7 1 min]\n[Point left, then right.]\n\nSAY:\nLeft: BMI from weight and height.\nRight: our model on CDC data.\nSame line. Same score. 0.998 on both.\n\nOn the left, we knew the formula.\nOn the right, the formula was hidden from us.\n\nOur CDC model had found its own BMI.\n\nNEXT: so what was the hidden formula?", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[7:30 \u00b7 1 min]\n[Point left, then right.]\n\nSAY:\nLeft: BMI from weight and height.\nRight: our model on CDC data.\nSame line. Same score. 0.998 on both.\n\nOn the left, we knew the formula.\nOn the right, the formula was hidden from us.\n\nOur CDC model had found its own BMI.\n\nNEXT: so what was the hidden formula?", "autoResize": true, "lineHeight": 1.25}, {"id": "viamr8aubnuub5zv", "type": "text", "x": 110, "y": 9460, "width": 432.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "emfltw3w1e5ulrq8", "roundness": null, "seed": 749492482, "version": 1, "versionNonce": 246737524, "isDeleted": false, "boundElements": [], "updated": 1794157960853, "link": null, "locked": false, "text": "Look familiar?", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Look familiar?", "autoResize": true, "lineHeight": 1.25}, {"id": "0cfv5zq3abuud0vk", "type": "image", "x": 140, "y": 9570, "width": 760.0, "height": 760, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "emfltw3w1e5ulrq8", "roundness": null, "seed": 401359149, "version": 1, "versionNonce": 79892170, "isDeleted": false, "boundElements": [], "updated": 1794157960854, "link": null, "locked": false, "fileId": "88879a6b1b0777c35f0094784190347477bbe629", "status": "saved", "scale": [1, 1], "crop": null}, {"id": "jnj7fwx1w89jvoq4", "type": "image", "x": 1020, "y": 9570, "width": 760.0, "height": 760, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "emfltw3w1e5ulrq8", "roundness": null, "seed": 135864012, "version": 1, "versionNonce": 1328230476, "isDeleted": false, "boundElements": [], "updated": 1794157960854, "link": null, "locked": false, "fileId": "546112462a8b8512f70dd10d88b33687d58e1f65", "status": "saved", "scale": [1, 1], "crop": null}, {"id": "939rx77riqa94gxj", "type": "text", "x": 302.0, "y": 10355, "width": 436.0, "height": 40.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "emfltw3w1e5ulrq8", "roundness": null, "seed": 979972588, "version": 1, "versionNonce": 1721612437, "isDeleted": false, "boundElements": [], "updated": 1794157960855, "link": null, "locked": false, "text": "BMI from weight and height", "fontSize": 32, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "BMI from weight and height", "autoResize": true, "lineHeight": 1.25}, {"id": "fbihd86n9lqxjlk7", "type": "text", "x": 1284.5, "y": 10355, "width": 231.0, "height": 40.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "emfltw3w1e5ulrq8", "roundness": null, "seed": 124738621, "version": 1, "versionNonce": 1506795402, "isDeleted": false, "boundElements": [], "updated": 1794157960855, "link": null, "locked": false, "text": "our CDC model", "fontSize": 32, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "our CDC model", "autoResize": true, "lineHeight": 1.25}, {"id": "p25nwy3nubgaezwd", "type": "frame", "x": 0, "y": 10720, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "emfltw3w1e5ulrq8", "roundness": null, "seed": 979753981, "version": 1, "versionNonce": 1614873069, "isDeleted": false, "boundElements": [], "updated": 1794157960855, "link": null, "locked": false, "name": "09 The loop"}, {"id": "0yobqbq1pownu1rt", "type": "text", "x": 2000, "y": 10720, "width": 928.0, "height": 650.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2141476552, "version": 1, "versionNonce": 930329817, "isDeleted": false, "boundElements": [], "updated": 1794157960860, "link": null, "locked": false, "text": "Notes\n\n[8:30 \u00b7 1.5 min]\n[Trace the top path with your hand, then the bottom path.]\n\nSAY:\nCDC builds a score called Theme 1 from exactly five columns.\nPoverty, unemployment, housing cost, no diploma, no insurance.\nThat's the top path.\n\nWe gave our model the same five columns.\nThat's the bottom path.\n\nSo the answer went in, and the answer came out.\nThe model relearned CDC's formula.\nIt told us nothing new about the world.\n\nThis is called target leakage. Our inputs already contained the answer.\n\nNEXT: so what does a real result look like?", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[8:30 \u00b7 1.5 min]\n[Trace the top path with your hand, then the bottom path.]\n\nSAY:\nCDC builds a score called Theme 1 from exactly five columns.\nPoverty, unemployment, housing cost, no diploma, no insurance.\nThat's the top path.\n\nWe gave our model the same five columns.\nThat's the bottom path.\n\nSo the answer went in, and the answer came out.\nThe model relearned CDC's formula.\nIt told us nothing new about the world.\n\nThis is called target leakage. Our inputs already contained the answer.\n\nNEXT: so what does a real result look like?", "autoResize": true, "lineHeight": 1.25}, {"id": "k4ritsfva5pku2nd", "type": "text", "x": 110, "y": 10800, "width": 1273.0, "height": 75.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "p25nwy3nubgaezwd", "roundness": null, "seed": 901162283, "version": 1, "versionNonce": 1547753179, "isDeleted": false, "boundElements": [], "updated": 1794157960861, "link": null, "locked": false, "text": "The answer went in. The answer came out.", "fontSize": 60, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The answer went in. The answer came out.", "autoResize": true, "lineHeight": 1.25}, {"id": "c2l1itbhjaitj6wg", "type": "rectangle", "x": 150, "y": 10960, "width": 320, "height": 84, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "p25nwy3nubgaezwd", "roundness": {"type": 3}, "seed": 724741615, "version": 1, "versionNonce": 1994922683, "isDeleted": false, "boundElements": [{"type": "text", "id": "zf0vzvcpmaci6o1g"}], "updated": 1794157960861, "link": null, "locked": false}, {"id": "zf0vzvcpmaci6o1g", "type": "text", "x": 252.0, "y": 10982.0, "width": 116.0, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "p25nwy3nubgaezwd", "roundness": null, "seed": 85620653, "version": 1, "versionNonce": 207527035, "isDeleted": false, "boundElements": [], "updated": 1794157960861, "link": null, "locked": false, "text": "poverty", "fontSize": 32, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "c2l1itbhjaitj6wg", "originalText": "poverty", "autoResize": true, "lineHeight": 1.25}, {"id": "uehh5i71alo8j86h", "type": "rectangle", "x": 150, "y": 11070, "width": 320, "height": 84, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "p25nwy3nubgaezwd", "roundness": {"type": 3}, "seed": 1518583138, "version": 1, "versio