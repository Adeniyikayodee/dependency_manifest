oundness": {"type": 2}, "seed": 1315179733, "version": 1, "versionNonce": 1804194916, "isDeleted": false, "boundElements": [], "updated": 1794157960801, "link": null, "locked": false, "points": [[0, 0], [0.0, 118.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "dmmex6l2qagwncxv", "focus": 0, "gap": 6}, "endBinding": {"elementId": "gz9j8fkzr0st0dtw", "focus": 0, "gap": 6}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "tp1yx262lba53p23", "type": "image", "x": 1140, "y": 2910, "width": 760.0, "height": 760, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "40vstqqzpt49zhkk", "roundness": null, "seed": 771243111, "version": 1, "versionNonce": 2032459487, "isDeleted": false, "boundElements": [], "updated": 1794157960822, "link": null, "locked": false, "fileId": "88879a6b1b0777c35f0094784190347477bbe629", "status": "saved", "scale": [1, 1], "crop": null}, {"id": "zgeiw1xf266ccifu", "type": "frame", "x": 0, "y": 4020, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "40vstqqzpt49zhkk", "roundness": null, "seed": 343459770, "version": 1, "versionNonce": 233066086, "isDeleted": false, "boundElements": [], "updated": 1794157960822, "link": null, "locked": false, "name": "04 What R\u00b2 means"}, {"id": "6yibehmi5skoewqk", "type": "text", "x": 2000, "y": 4020, "width": 972.0, "height": 552.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1390877945, "version": 1, "versionNonce": 1181084186, "isDeleted": false, "boundElements": [], "updated": 1794157960828, "link": null, "locked": false, "text": "Notes\n\n[3:30 \u00b7 1 min]\n[Quick. This slide is a key, not a lecture.]\n\nSAY:\nQuick one, because this number matters for the rest of the talk.\nR squared tells us how close the model's guesses are to the real answers.\n\nLeft: 1.0. Every dot on the line. Every guess spot on.\nMiddle: about 0.5. A rough idea.\nRight: zero. No idea at all.\n\nIn real life, with messy data, 0.5 is often a good result.\n0.998 is almost unheard of.\n\nNEXT: so back to BMI, but now let's hide the formula.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[3:30 \u00b7 1 min]\n[Quick. This slide is a key, not a lecture.]\n\nSAY:\nQuick one, because this number matters for the rest of the talk.\nR squared tells us how close the model's guesses are to the real answers.\n\nLeft: 1.0. Every dot on the line. Every guess spot on.\nMiddle: about 0.5. A rough idea.\nRight: zero. No idea at all.\n\nIn real life, with messy data, 0.5 is often a good result.\n0.998 is almost unheard of.\n\nNEXT: so back to BMI, but now let's hide the formula.", "autoResize": true, "lineHeight": 1.25}, {"id": "3jq64nq6puxcmlzk", "type": "text", "x": 110, "y": 4100, "width": 764.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "zgeiw1xf266ccifu", "roundness": null, "seed": 1194852050, "version": 1, "versionNonce": 1407994772, "isDeleted": false, "boundElements": [], "updated": 1794157960828, "link": null, "locked": false, "text": "What does 0.998 mean?", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What does 0.998 mean?", "autoResize": true, "lineHeight": 1.25}, {"id": "ykqh7dx297gq8zxq", "type": "image", "x": 110, "y": 4230, "width": 1700, "height": 613.8888888888889, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "zgeiw1xf266ccifu", "roundness": null, "seed": 1613790070, "version": 1, "versionNonce": 1584604460, "isDeleted": false, "boundElements": [], "updated": 1794157960829, "link": null, "locked": false, "fileId": "82f2c33c5dbd0a1004e3c64a0044d859a30c755d", "status": "saved", "scale": [1, 1], "crop": null}, {"id": "jxvf2olds7qtuaco", "type": "text", "x": 410.0, "y": 4920, "width": 1100.0, "height": 57.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "zgeiw1xf266ccifu", "roundness": null, "seed": 641516765, "version": 1, "versionNonce": 1249713597, "isDeleted": false, "boundElements": [], "updated": 1794157960830, "link": null, "locked": false, "text": "R\u00b2 = how close the guesses are.  1.0 is perfect.", "fontSize": 46, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "R\u00b2 = how close the guesses are.  1.0 is perfect.", "autoResize": true, "lineHeight": 1.25}, {"id": "106xdi5ocbdawtg7", "type": "frame", "x": 0, "y": 5360, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "zgeiw1xf266ccifu", "roundness": null, "seed": 1533954225, "version": 1, "versionNonce": 963184922, "isDeleted": false, "boundElements": [], "updated": 1794157960831, "link": null, "locked": false, "name": "05 Now hide the formula"}, {"id": "0tinx4kiapj2gejr", "type": "text", "x": 2000, "y": 5360, "width": 690.0, "height": 520.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1726374510, "version": 1, "versionNonce": 1134901445, "isDeleted": false, "boundElements": [], "updated": 1794157960836, "link": null, "locked": false, "text": "Notes\n\n[4:30 \u00b7 1 min]\nSAY:\nNow imagine the formula is on page 80 of a PDF,\nwritten by a different organisation.\nThe two columns arrive in a CSV. No recipe attached.\nSame model. Same 0.998.\n\n[ASK] Would you spot it?\n[Pause.]\n\nHonestly, most of us wouldn't. We'd celebrate.\nThis is what a lot of public data looks like.\n\nNEXT: and this is exactly what happened to us.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[4:30 \u00b7 1 min]\nSAY:\nNow imagine the formula is on page 80 of a PDF,\nwritten by a different organisation.\nThe two columns arrive in a CSV. No recipe attached.\nSame model. Same 0.998.\n\n[ASK] Would you spot it?\n[Pause.]\n\nHonestly, most of us wouldn't. We'd celebrate.\nThis is what a lot of public data looks like.\n\nNEXT: and this is exactly what happened to us.", "autoResize": true, "lineHeight": 1.25}, {"id": "ad9w275pkacd8bzl", "type": "text", "x": 110, "y": 5440, "width": 662.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "106xdi5ocbdawtg7", "roundness": null, "seed": 1020779760, "version": 1, "versionNonce": 683830195, "isDeleted": false, "boundElements": [], "updated": 1794157960837, "link": null, "locked": false, "text": "Now hide the formula", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Now hide the formula", "autoResize": true, "lineHeight": 1.25}, {"id": "dga9mj0m760l6tet", "type": "rectangle", "x": 140, "y"