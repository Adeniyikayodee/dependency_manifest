\u00b7 1.5 min]\n[ENERGY UP. This is the audience moment.]\n\nSAY:\nYour turn.\nWe want to predict the FEMA risk score.\nHere are three inputs. Which one is safe to use?\n\nA: poverty rate. B: unemployment rate. C: rainfall.\n\n[ASK] Shout it out. A, B or C?\n[Let them shout. Repeat what you hear.]\n\nHold that thought. Let's walk the graph and see.\n\n[CLICK]", "autoResize": true, "lineHeight": 1.25}, {"id": "3m4j4lnv6p20t5za", "type": "text", "x": 110, "y": 26880, "width": 909.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "cap3g7ifcofix0b9", "roundness": null, "seed": 1802292002, "version": 1, "versionNonce": 1714455169, "isDeleted": false, "boundElements": [], "updated": 1794157960952, "link": null, "locked": false, "text": "Your turn: which one is safe?", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Your turn: which one is safe?", "autoResize": true, "lineHeight": 1.25}, {"id": "o414x5anws8sknef", "type": "rectangle", "x": 760, "y": 27000, "width": 400, "height": 110, "angle": 0, "strokeColor": "#f08c00", "backgroundColor": "#ffec99", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "cap3g7ifcofix0b9", "roundness": {"type": 3}, "seed": 882201848, "version": 1, "versionNonce": 1529334266, "isDeleted": false, "boundElements": [{"type": "text", "id": "jf7jcr6ultm29ohh"}], "updated": 1794157960952, "link": null, "locked": false}, {"id": "jf7jcr6ultm29ohh", "type": "text", "x": 801.5, "y": 27030.0, "width": 317.0, "height": 50.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "cap3g7ifcofix0b9", "roundness": null, 