solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "106xdi5ocbdawtg7", "roundness": null, "seed": 149508109, "version": 1, "versionNonce": 1587562917, "isDeleted": false, "boundElements": [], "updated": 1794157960838, "link": null, "locked": false, "text": "0.998", "fontSize": 64, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "0.998", "autoResize": true, "lineHeight": 1.25}, {"id": "35ezhfquof6zl2kx", "type": "text", "x": 666.5, "y": 6260, "width": 587.0, "height": 80.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "106xdi5ocbdawtg7", "roundness": null, "seed": 1009869667, "version": 1, "versionNonce": 952288159, "isDeleted": false, "boundElements": [], "updated": 1794157960838, "link": null, "locked": false, "text": "Would you spot it?", "fontSize": 64, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Would you spot it?", "autoResize": true, "lineHeight": 1.25}, {"id": "lcqwd9bdq64dgjua", "type": "frame", "x": 0, "y": 6700, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "106xdi5ocbdawtg7", "roundness": null, "seed": 854490981, "version": 1, "versionNonce": 1283305048, "isDeleted": false, "boundElements": [], "updated": 1794157960838, "link": null, "locked": false, "name": "06 Then it happened to us"}, {"id": "2g4uxqyhx4yk2pja", "type": "text", "x": 2000, "y": 6700, "width": 909.0, "height": 422.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2009607510, "version": 1, "versionNonce": 837964227, "isDeleted": false, "boundElements": [], "updated": 1794157960842, "link": null, "locked": false, "text": "Notes\n\n[5:30 \u00b7 1 min]\n[EDIT THIS SLIDE: say the lab name and the project in one line.]\n\nSAY:\nIn our lab we build models on free public data.\nCDC, FEMA, the US Census.\nIt's good data, and anyone can check our work. That's why we use it.\n\nWe were building a model. We ran it.\n\nNEXT: here's the score we got.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[5:30 \u00b7 1 min]\n[EDIT THIS SLIDE: say the lab name and the project in one line.]\n\nSAY:\nIn our lab we build models on free public data.\nCDC, FEMA, the US Census.\nIt's good data, and anyone can check our work. That's why we use it.\n\nWe were building a model. We ran it.\n\nNEXT: here's the score we got.", "autoResize": true, "lineHeight": 1.25}, {"id": "ckoexi2gybe2vuo4", "type": "text", "x": 110, "y": 6780, "width": 743.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "lcqwd9bdq64dgjua", "roundness": null, "seed": 496542837, "version": 1, "versionNonce": 1572095810, "isDeleted": false, "boundElements": [], "updated": 1794157960842, "link": null, "locked": false, "text": "Then it happened to us", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Then it happened to us", "autoResize": true, "lineHeight": 1.25}, {"id": "jvodl29j2jr00pjb", "type": "rectangle", "x": 152, "y": 6928, "width": 110, "height": 140, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId":