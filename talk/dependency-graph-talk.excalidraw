153, "version": 1, "versionNonce": 340095405, "isDeleted": false, "boundElements": [], "updated": 1794157960915, "link": null, "locked": false, "points": [[0, 0], [224.0, 128.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "b8yu5n19n5c4nu4a", "focus": 0, "gap": 6}, "endBinding": {"elementId": "vh6l1qf25tx77cv0", "focus": 0, "gap": 6}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "nw1mef7cib752qrb", "type": "frame", "x": 0, "y": 21440, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "zvmp1w38xiyes0ss", "roundness": null, "seed": 1763054042, "version": 1, "versionNonce": 1161906930, "isDeleted": false, "boundElements": [], "updated": 1794157960915, "link": null, "locked": false, "name": "17 A real chain (3)"}, {"id": "7cri3nnpjbri50xa", "type": "text", "x": 2000, "y": 21440, "width": 900.0, "height": 617.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1867218404, "version": 1, "versionNonce": 1800188679, "isDeleted": false, "boundElements": [], "updated": 1794157960920, "link": null, "locked": false, "text": "Notes\n\n[18:30 \u00b7 1 min]\nSAY:\nRoute two, in red. Pure arithmetic this time.\nThe same unemployment column feeds an index called BRIC,\nwhich becomes community resilience, which also goes into the risk score.\n\nOne column. Two routes into the target.\nThree different agencies along the way.\nNobody owns the whole picture.\n\nIf we predict the risk score using unemployment,\nwe're feeding it its own ingredient. Twice.\n\nThis all comes from FEMA's own published documentation.\nIt's there. It's just in a PDF.\n\nNEXT: how to read any graph like this.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[18:30 \u00b7 1 min]\nSAY:\nRoute two, in red. Pure arithmetic this time.\nThe same unemployment column feeds an index called BRIC,\nwhich becomes community resilience, which also goes into the risk score.\n\nOne column. Two routes into the target.\nThree different agencies along the way.\nNobody owns the whole picture.\n\nIf we predict the risk score using unemployment,\nwe're feeding it its own ingredient. Twice.\n\nThis all comes from FEMA's own published documentation.\nIt's there. It's just in a PDF.\n\nNEXT: how to read any graph like this.", "autoResize": true, "lineHeight": 1.25}, {"id": "d6g5czi55lj6zi60", "type": "text", "x": 110, "y": 21520, "width": 784.0, "height": 80.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "nw1mef7cib752qrb", "roundness": null, "seed": 1194043008, "version": 1, "versionNonce": 1143049424, "isDeleted": false, "boundElements": [], "updated": 1794157960920, "link": null, "locked": false, "text": "Route 2: pure arithmetic", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Route 2: pure arithmetic", "autoResize": true, "lineHeight": 1.25}, {"id": "fph3xg686l7nibfv", "type": "rectangle", "x": 330, "y": 21630, "width": 300, "height": 90, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "nw1mef7cib752qrb", "roundness": {"type": 3}, "seed": 993552731, "version": 1, "versionNonce": 1345065950, "isDeleted": false, "boundElements": [{"type": "text", "id": "ohd0lcf44n0tnj93"}, {"type": "arrow", "id": "pk76slh9lbpx664i"}], "updated": 1794157960920, "link": null, "locked": fals