": 35235.0, "width": 106.0, "height": 50.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "m00v71xn37bx6w85", "roundness": null, "seed": 1616996243, "version": 1, "versionNonce": 1858990482, "isDeleted": false, "boundElements": [], "updated": 1794157960991, "link": null, "locked": false, "text": "2027", "fontSize": 40, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "5heo4a6pz82rl7wo", "originalText": "2027", "autoResize": true, "lineHeight": 1.25}, {"id": "rwt1l8hts3732sit", "type": "text", "x": 720.5, "y": 35660, "width": 479.0, "height": 65.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "m00v71xn37bx6w85", "roundness": null, "seed": 375068131, "version": 1, "versionNonce": 1232164955, "isDeleted": false, "boundElements": [], "updated": 1794157960991, "link": null, "locked": false, "text": "Treat it like code.", "fontSize": 52, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Treat it like code.", "autoResize": true, "lineHeight": 1.25}, {"id": "76zzoaryrcv1bzjd", "type": "frame", "x": 0, "y": 36180, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "m00v71xn37bx6w85", "roundness": null, "seed": 2127083568, "version": 1, "versionNonce": 79968672, "isDeleted": false, "boundElements": [], "updated": 1794157960991, "link": null, "locked": false, "name": "28 Next time"}, {"id": "rguykpi863wnhfvh", "type": "text", "x": 2000, "y": 36180, "width": 764.0, "height": 552.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1783577572, "version": 1, "versionNonce": 654957157, "isDeleted": false, "boundElements": [], "updated": 1794157960995, "link": null, "locked": false, "text": "Notes\n\n[32:30 \u00b7 1 min]\nSAY:\nBack to BMI.\nNext time a score looks too good, ask one question:\nis this BMI?\n\nAnd if you want more, three questions for any input column:\nWhat was it made from?\nDoes it share a parent with our target?\nWho published both?\n\nIf we can't answer them, that column is untraced.\nThat's fine. Now we know what we don't know.\n\nNEXT: thank you.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[32:30 \u00b7 1 min]\nSAY:\nBack to BMI.\nNext time a score looks too good, ask one question:\nis this BMI?\n\nAnd if you want more, three questions for any input column:\nWhat was it made from?\nDoes it share a parent with our target?\nWho published both?\n\nIf we can't answer them, that column is untraced.\nThat's fine. Now we know what we don't know.\n\nNEXT: thank you.", "autoResize": true, "lineHeight": 1.25}, {"id": "gm3n4p0zyn3nslto", "type": "text", "x": 110, "y": 36260, "width": 1071.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "76zzoaryrcv1bzjd", "roundness": null, "seed": 448810363, "version": 1, "versionNonce": 1657185736, "isDeleted": false, "boundElements": [], "updated": 1794157960995, "link": null, "locked": false, "text": "Next time a score looks too good", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Next time a score looks too good", "autoResize": true, "lineHeight": 1.25}, {"id"