": 1794157960996, "link": null, "locked": false, "name": "29 Thank you"}, {"id": "ugd9m7vqwcxtdpl4", "type": "text", "x": 2000, "y": 37520, "width": 1575.0, "height": 455.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1716131874, "version": 1, "versionNonce": 842697526, "isDeleted": false, "boundElements": [], "updated": 1794157961001, "link": null, "locked": false, "text": "Notes\n\n[33:30 \u00b7 then Q&A]\nSAY:\nThank you.\nIf this was useful, scan the code and say hello on LinkedIn.\nHappy to chat about your own data afterwards.\n\n[ASK] Questions?\n\nBACKUP ANSWERS:\n\"Is this only a Python thing?\" No. Any project with a dependency graph and a CI job can do it.\n\"Doesn't cross-validation catch it?\" No. The leak is inside every fold.\n\"Who should write these graphs?\" Ideally the agencies themselves. Until then, any team can start one for its own project.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[33:30 \u00b7 then Q&A]\nSAY:\nThank you.\nIf this was useful, scan the code and say hello on LinkedIn.\nHappy to chat about your own data afterwards.\n\n[ASK] Questions?\n\nBACKUP ANSWERS:\n\"Is this only a Python thing?\" No. Any project with a dependency graph and a CI job can do it.\n\"Doesn't cross-validation catch it?\" No. The leak is inside every fold.\n\"Who should write these graphs?\" Ideally the agencies themselves. Until then, any team can start one for its own project.", "autoResize": true, "lineHeight": 1.25}, {"id": "vviro1eoqv9bprd6", "type": "text", "x": 719.5, "y": 37610, "width": 481.0, "height": 120.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [],