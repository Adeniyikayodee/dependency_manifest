}, {"id": "m00v71xn37bx6w85", "type": "frame", "x": 0, "y": 34840, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "ihn0uqc7ww90zxwp", "roundness": null, "seed": 993209231, "version": 1, "versionNonce": 1805370014, "isDeleted": false, "boundElements": [], "updated": 1794157960986, "link": null, "locked": false, "name": "27 Looking after the graph"}, {"id": "397gpoqsr7cbp7pt", "type": "text", "x": 2000, "y": 34840, "width": 927.0, "height": 455.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1319658670, "version": 1, "versionNonce": 787562185, "isDeleted": false, "boundElements": [], "updated": 1794157960990, "link": null, "locked": false, "text": "Notes\n\n[31:30 \u00b7 1 min]\nSAY:\nFive habits.\nOne: keep it in the repo and review it in PRs.\nTwo: every arrow says how sure we are.\nThree: log every fix. Our first check of our own file found six mistakes.\nFour: unknown names fail the build.\nFive: when a dataset ships a new version, check it again.\n\nTreat it like code. Because it is.\n\nNEXT: back to where we started.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[31:30 \u00b7 1 min]\nSAY:\nFive habits.\nOne: keep it in the repo and review it in PRs.\nTwo: every arrow says how sure we are.\nThree: log every fix. Our first check of our own file found six mistakes.\nFour: unknown names fail the build.\nFive: when a dataset ships a new version, check it again.\n\nTreat it like code. Because it is.\n\nNEXT: back to where we started.", "autoResize": true, "lineHeight": 1.25}, {"id": "6l0elowzfsxlj1ot", "type": "text", "x": 110, "y": 34920, "width": 754.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "m00v71xn37bx6w85", "roundness": null, "seed": 1015575268, "version": 1, "versionNonce": 1027828617, "isDeleted": false, "boundElements": [], "updated": 1794157960990, "link": null, "locked": false, "text": "Looking after the graph", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Looking after the graph", "autoResize": true, "lineHeight": 1.25}, {"id": "ia99k64nonyg9nu1", "type": "rectangle", "x": 110, "y": 35140, "width": 300, "height": 300, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "m00v71xn37bx6w85", "roundness": {"type": 3}, "seed": 459289580, "version": 1, "versionNonce": 988038969, "isDeleted": false, "boundElements": [], "updated": 1794157960990, "link": null, "locked": false}, {"id": "7w5m8pl52jspbb1n", "type": "text", "x": 137.5, "y": 35480, "width": 245.0, "height": 47.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "m00v71xn37bx6w85", "roundness": null, "seed": 1751908616, "version": 1, "versionNonce": 1734232808, "isDeleted": false, "boundElements": [], "updated": 1794157960990, "link": null, "locked": false, "text": "review in PRs", "fontSize": 38, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "review in PRs", "autoResize": true, "lineHeight": 1.25}, {"id": "qz44njbguxs1xz8o", "type": "rectangle", "x": 460, "y": 35140, "width": 300, "height": 300, "angle": 0, "strokeColor": "#f08c00", "backgroundColor": "#ffec99