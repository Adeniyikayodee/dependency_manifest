okeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "j0bryfsn3ubepvjl", "roundness": null, "seed": 377800399, "version": 1, "versionNonce": 1934578490, "isDeleted": false, "boundElements": [], "updated": 1794157960964, "link": null, "locked": false, "text": "no graph, no answer", "fontSize": 46, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "no graph, no answer", "autoResize": true, "lineHeight": 1.25}, {"id": "gq26d8bom2kfh9hn", "type": "frame", "x": 0, "y": 30820, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "j0bryfsn3ubepvjl", "roundness": null, "seed": 240090137, "version": 1, "versionNonce": 326841583, "isDeleted": false, "boundElements": [], "updated": 1794157960964, "link": null, "locked": false, "name": "24 Step 4. Run it on every push"}, {"id": "vkyobgil8u3v36a7", "type": "text", "x": 2000, "y": 30820, "width": 663.0, "height": 455.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1088789840, "version": 1, "versionNonce": 1569305325, "isDeleted": false, "boundElements": [], "updated": 1794157960967, "link": null, "locked": false, "text": "Notes\n\n[27:00 \u00b7 1 min]\nSAY:\nStep four: put it in CI, right next to the tests.\nEvery push, the lineage check runs.\nIt takes about a tenth of a second. No network.\n\nLeak found: build goes red.\nBroken manifest: build goes red too.\nAnd a typo in a column name? Also red.\nA name the tool doesn't know can never be cleared.\n\nNEXT: let's watch it go red for real.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[27:00 \u00b7 1 min]\nSAY:\nStep four: put it in CI, right next to the tests.\nEvery push, the lineage check runs.\nIt takes about a tenth of a second. No network.\n\nLeak found: build goes red.\nBroken manifest: build goes red too.\nAnd a typo in a column name? Also red.\nA name the tool doesn't know can never be cleared.\n\nNEXT: let's watch it go red for real.", "autoResize": true, "lineHeight": 1.25}, {"id": "fdajzk3kh6uefi4j", "type": "text", "x": 110, "y": 30900, "width": 771.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "gq26d8bom2kfh9hn", "roundness": null, "seed": 498334488, "version": 1, "versionNonce": 1420300712, "isDeleted": false, "boundElements": [], "updated": 1794157960967, "link": null, "locked": false, "text": "4.  Run it on every push", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4.  Run it on every push", "autoResize": true, "lineHeight": 1.25}, {"id": "1c65iydqgcqn6ikt", "type": "rectangle", "x": 130, "y": 31200, "width": 280, "height": 120, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "gq26d8bom2kfh9hn", "roundness": {"type": 3}, "seed": 899885816, "version": 1, "versionNonce": 1513656446, "isDeleted": false, "boundElements": [{"type": "text", "id": "of17gxssj06rdsei"}, {"type": "arrow", "id": "qga0yz22gfbvtmje"}], "updated": 1794157960967, "link": null, "locked": false}, {"id": "of17gxssj06rdsei", "type": "text", "x": 191.5, "y": 31235.0, "width": 157.0, "height": 50.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "soli