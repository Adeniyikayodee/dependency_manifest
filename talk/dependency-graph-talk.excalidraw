2, "isDeleted": false, "boundElements": [], "updated": 1794157960792, "link": null, "locked": false, "text": "!", "fontSize": 55, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "!", "autoResize": true, "lineHeight": 1.25}, {"id": "x1bz99nfd02is5d9", "type": "text", "x": 570, "y": 2115, "width": 768.0, "height": 100.0, "angle": 0, "strokeColor": "#ffd43b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "mnbqns6puq80idw3", "roundness": null, "seed": 546797965, "version": 1, "versionNonce": 733420649, "isDeleted": false, "boundElements": [], "updated": 1794157960793, "link": null, "locked": false, "text": "Circular dependency detected:\nsrc/a.js -> src/b.js -> src/a.js", "fontSize": 40, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Circular dependency detected:\nsrc/a.js -> src/b.js -> src/a.js", "autoResize": true, "lineHeight": 1.25}, {"id": "40vstqqzpt49zhkk", "type": "frame", "x": 0, "y": 2680, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "mnbqns6puq80idw3", "roundness": null, "seed": 322855252, "version": 1, "versionNonce": 892805686, "isDeleted": false, "boundElements": [], "updated": 1794157960793, "link": null, "locked": false, "name": "03 BMI"}, {"id": "659o2v21i9mpflv9", "type": "text", "x": 2000, "y": 2680, "width": 857.0, "height": 585.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 391247226, "version": 1, "versionNonce": 1371330427, "isDeleted": false, "boundElements": [], "updated": 1794157960799, "link": null, "locked": false, "text": "Notes\n\n[2:00 \u00b7 1.5 min]\nSAY:\nSomething we've all seen at the doctor or on a fitness app. BMI.\nBMI is made from two numbers. Weight and height. That's it.\n\nImagine someone trains a model.\nInput: weight and height. Output: BMI.\nIt scores 0.998. Nearly perfect.\n\n[ASK] Who's impressed?\n[Pause. Nobody is.]\n\nExactly. We all know the formula.\nThe model didn't learn anything. It rediscovered a sum we gave it.\n\nNEXT: quick pause, what does 0.998 even mean?", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[2:00 \u00b7 1.5 min]\nSAY:\nSomething we've all seen at the doctor or on a fitness app. BMI.\nBMI is made from two numbers. Weight and height. That's it.\n\nImagine someone trains a model.\nInput: weight and height. Output: BMI.\nIt scores 0.998. Nearly perfect.\n\n[ASK] Who's impressed?\n[Pause. Nobody is.]\n\nExactly. We all know the formula.\nThe model didn't learn anything. It rediscovered a sum we gave it.\n\nNEXT: quick pause, what does 0.998 even mean?", "autoResize": true, "lineHeight": 1.25}, {"id": "pxqmb0y07nyrvd5r", "type": "text", "x": 110, "y": 2760, "width": 1157.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "40vstqqzpt49zhkk", "roundness": null, "seed": 1546812014, "version": 1, "versionNonce": 540623863, "isDeleted": false, "boundElements": [], "updated": 1794157960800, "link": null, "locked": false, "text": "Predict BMI from weight and height?", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Predict BMI from weight and height?", "autoResize": true, "lineHeight": 1.25}, {"id": "67nfrpyz21tbic14", "type": "rectangle", "x": 140, "y": 2940, "width": 240, "height": 216.0, "angle"