": 275979241, "isDeleted": false, "boundElements": [], "updated": 1794157960875, "link": null, "locked": false, "text": "nobody checked", "fontSize": 44, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "nobody checked", "autoResize": true, "lineHeight": 1.25}, {"id": "8h3kn7d8p07fnnsa", "type": "frame", "x": 0, "y": 14740, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "k55iqtd3k1y6t8he", "roundness": null, "seed": 1117506243, "version": 1, "versionNonce": 1852798139, "isDeleted": false, "boundElements": [], "updated": 1794157960875, "link": null, "locked": false, "name": "12 It's in your code too"}, {"id": "hl2kszpvqbfnqjee", "type": "text", "x": 2000, "y": 14740, "width": 921.0, "height": 780.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1679893140, "version": 1, "versionNonce": 1305241593, "isDeleted": false, "boundElements": [], "updated": 1794157960884, "link": null, "locked": false, "text": "Notes\n\n[12:30 \u00b7 2 min]\n[Point at each card. This is the slide that makes it about THEM.]\n\nSAY:\nThis isn't only a data science thing. You've probably got it at work.\n\nSnapshot tests. Our code writes the snapshot,\nthen the test checks our code against it.\nExpected equals actual, by construction. It can never fail.\n\nAI evals. If the test questions leaked into the training data,\nthe model scores 95%. It isn't smart. It saw the answers.\n\nProduct metrics. Click rate is made from clicks.\nUse click rate to predict clicks, and we get a beautiful, useless model.\n\nSame loop every time. The answer sneaks in as an input.\n\n[ASK] Anyone recognise one of these from their own codebase?\n[Let a hand or two go up. Nod.]\n\nNEXT: so how do JS tools stop loops? They write the graph down.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[12:30 \u00b7 2 min]\n[Point at each card. This is the slide that makes it about THEM.]\n\nSAY:\nThis isn't only a data science thing. You've probably got it at work.\n\nSnapshot tests. Our code writes the snapshot,\nthen the test checks our code against it.\nExpected equals actual, by construction. It can never fail.\n\nAI evals. If the test questions leaked into the training data,\nthe model scores 95%. It isn't smart. It saw the answers.\n\nProduct metrics. Click rate is made from clicks.\nUse click rate to predict clicks, and we get a beautiful, useless model.\n\nSame loop every time. The answer sneaks in as an input.\n\n[ASK] Anyone recognise one of these from their own codebase?\n[Let a hand or two go up. Nod.]\n\nNEXT: so how do JS tools stop loops? They write the graph down.", "autoResize": true, "lineHeight": 1.25}, {"id": "eee8aexej9h56r2l", "type": "text", "x": 110, "y": 14820, "width": 668.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "8h3kn7d8p07fnnsa", "roundness": null, "seed": 429878357, "version": 1, "versionNonce": 1094953088, "isDeleted": false, "boundElements": [], "updated": 1794157960884, "link": null, "locked": false, "text": "It's in your code too", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "It's in your code too", "autoResize": true, "lineHeight": 1.25}, {"id": "tz0l2g3vunbyognw", "type": "rectangle", "x": 110, "y": 14940, "width": 540, "height": 760, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 