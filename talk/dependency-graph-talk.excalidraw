ull, "locked": false, "points": [[0, 0], [-50, 50]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "mpo4uhcu7f63hpn2", "type": "text", "x": 1685.5, "y": 16980, "width": 139.0, "height": 32.5, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "9ac4w6z1tk9ajxzu", "roundness": null, "seed": 1337138231, "version": 1, "versionNonce": 1788613823, "isDeleted": false, "boundElements": [], "updated": 1794157960898, "link": null, "locked": false, "text": "no lock file", "fontSize": 26, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "no lock file", "autoResize": true, "lineHeight": 1.25}, {"id": "xaohvzp1pvpyc79t", "type": "line", "x": 960, "y": 16280, "width": 0, "height": 780, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "9ac4w6z1tk9ajxzu", "roundness": {"type": 2}, "seed": 1156123551, "version": 1, "versionNonce": 2015994283, "isDeleted": false, "boundElements": [], "updated": 1794157960899, "link": null, "locked": false, "points": [[0, 0], [0, 780]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "43ady3ol49ykgq2f", "type": "frame", "x": 0, "y": 17420, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "9ac4w6z1tk9ajxzu", "roundness": null, "seed": 1334310623, "version": 1, "versionNonce": 1983654950, "isDeleted": false, "boundElements": [], "updated": 1794157960899, "link": null, "locked": false, "name": "14 Two questions"}, {"id": "naefflxa1063sw7x", "type": "text", "x": 2000, "y": 17420, "width": 690.0, "height": 520.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 726822136, "version": 1, "versionNonce": 430391298, "isDeleted": false, "boundElements": [], "updated": 1794157960902, "link": null, "locked": false, "text": "Notes\n\n[16:00 \u00b7 1 min]\nSAY:\nTwo questions we can ask about any column.\n\nQuestion one: where did this file come from?\nWhich website, which download.\nData catalogues record this really well.\n\nQuestion two: what was this number made from?\nAlmost nobody records that.\n\nAnd the leak always lives in question two.\n\nNEXT: let's answer question two for a real dataset.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[16:00 \u00b7 1 min]\nSAY:\nTwo questions we can ask about any column.\n\nQuestion one: where did this file come from?\nWhich website, which download.\nData catalogues record this really well.\n\nQuestion two: what was this number made from?\nAlmost nobody records that.\n\nAnd the leak always lives in question two.\n\nNEXT: let's answer question two for a real dataset.", "autoResize": true, "lineHeight": 1.25}, {"id": "675hxs8noywv9rsf", "type": "text", "x": 110, "y": 17500, "width": 1021.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "43ady3ol49ykgq2f", "roundness": null, "seed": 1586493045, "version": 1, "versionNonce": 491300742, "isDeleted": false, "boundElements": [], "updated": 1794157960902, "link": null, "locked": false, "text": "Two questions about any column", "fontSize": 64, "fontFamily": 1, "textAl