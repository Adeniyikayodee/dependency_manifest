7569, "isDeleted": false, "boundElements": [], "updated": 1794157960909, "link": null, "locked": false, "name": "16 A real chain (2)"}, {"id": "1u2sm4tyfh2e21q5", "type": "text", "x": 2000, "y": 20100, "width": 620.0, "height": 422.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1110822093, "version": 1, "versionNonce": 1696768571, "isDeleted": false, "boundElements": [], "updated": 1794157960912, "link": null, "locked": false, "text": "Notes\n\n[17:30 \u00b7 1 min]\nSAY:\nRoute one, in blue.\nThe unemployment rate from the ACS survey\nfeeds a Census statistical model.\nThat becomes FEMA's social vulnerability,\nwhich goes into the risk score.\n\nSo unemployment is already inside the risk score.\n\n[CLICK] But that's not the only way in.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[17:30 \u00b7 1 min]\nSAY:\nRoute one, in blue.\nThe unemployment rate from the ACS survey\nfeeds a Census statistical model.\nThat becomes FEMA's social vulnerability,\nwhich goes into the risk score.\n\nSo unemployment is already inside the risk score.\n\n[CLICK] But that's not the only way in.", "autoResize": true, "lineHeight": 1.25}, {"id": "go6k61ma4yvyh9fz", "type": "text", "x": 110, "y": 20180, "width": 783.0, "height": 80.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "zvmp1w38xiyes0ss", "roundness": null, "seed": 670063539, "version": 1, "versionNonce": 1321600923, "isDeleted": false, "boundElements": [], "updated": 1794157960912, "link": null, "locked": false, "text": "Route 1: through a model", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top