: "uytaxk74yrszz4jv", "type": "line", "x": 1694.08, "y": 28813.12, "width": 35.83999999999992, "height": 32.25599999999997, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 5, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "xb8ust5epn6aq4jh", "roundness": {"type": 2}, "seed": 989677262, "version": 1, "versionNonce": 404344188, "isDeleted": false, "boundElements": [], "updated": 1794157960958, "link": null, "locked": false, "points": [[0.0, 0.0], [13.619200000000092, 14.336000000000013], [35.83999999999992, -17.91999999999996]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "j0bryfsn3ubepvjl", "type": "frame", "x": 0, "y": 29480, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "xb8ust5epn6aq4jh", "roundness": null, "seed": 978370101, "version": 1, "versionNonce": 2083322355, "isDeleted": false, "boundElements": [], "updated": 1794157960958, "link": null, "locked": false, "name": "23 Step 3. Four answers"}, {"id": "iruu7jrf048tywbo", "type": "text", "x": 2000, "y": 29480, "width": 812.0, "height": 487.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2110092325, "version": 1, "versionNonce": 23669416, "isDeleted": false, "boundElements": [], "updated": 1794157960962, "link": null, "locked": false, "text": "Notes\n\n[26:00 \u00b7 1 min]\nSAY:\nStep three. Four possible answers.\n\nFAIL: an input sits on the target's path.\nREVIEW: two inputs share a parent. A human should look.\nPASS: we traced the target, and the inputs are clear of it.\nUNTRACED: nobody has written down this target's lineage yet.\n\nThat last one matters. An empty graph tells us nothing.\nSo it never gets to count as a pass.\n\nNEXT: and then we automate it.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[26:00 \u00b7 1 min]\nSAY:\nStep three. Four possible answers.\n\nFAIL: an input sits on the target's path.\nREVIEW: two inputs share a parent. A human should look.\nPASS: we traced the target, and the inputs are clear of it.\nUNTRACED: nobody has written down this target's lineage yet.\n\nThat last one matters. An empty graph tells us nothing.\nSo it never gets to count as a pass.\n\nNEXT: and then we automate it.", "autoResize": true, "lineHeight": 1.25}, {"id": "5k235xho3nvdsrzs", "type": "text", "x": 110, "y": 29560, "width": 539.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "j0bryfsn3ubepvjl", "roundness": null, "seed": 2038447615, "version": 1, "versionNonce": 1260398856, "isDeleted": false, "boundElements": [], "updated": 1794157960962, "link": null, "locked": false, "text": "3.  Four answers", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3.  Four answers", "autoResize": true, "lineHeight": 1.25}, {"id": "ecxkzixoyk62s7eb", "type": "rectangle", "x": 110, "y": 29720, "width": 400, "height": 440, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "j0bryfsn3ubepvjl", "roundness": {"type": 3}, "seed": 81999981, "version": 1, "versionNonce": 481516804, "isDeleted": false, "boundElements": [], "updated": 1794157960962, "link": null, "locked": false}, {"id": "1t4ij1ox3e0i4jbs", "type": "elli