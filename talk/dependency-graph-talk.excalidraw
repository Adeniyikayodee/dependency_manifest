], "frameId": null, "roundness": null, "seed": 85169019, "version": 1, "versionNonce": 1502548354, "isDeleted": false, "boundElements": [], "updated": 1794157960894, "link": null, "locked": false, "text": "Notes\n\n[14:30 \u00b7 1.5 min]\nSAY:\nEvery JS dev here trusts a dependency graph every day.\ndebug feeds body-parser. Both feed express. express feeds our app.\nAnd package-lock.json writes all of that down.\nThat's why npm can warn us about loops and conflicts.\n\nNow look at public data. The ACS survey feeds a Census estimate,\nwhich feeds a FEMA risk score.\nIs that written down anywhere a computer can read it?\nNo. There's no lock file for data.\n\nOne note: in all these drawings, sources sit at the top and flow down,\nlike a river. Upstream is where things come from.\n\nNEXT: two questions worth asking about any column.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[14:30 \u00b7 1.5 min]\nSAY:\nEvery JS dev here trusts a dependency graph every day.\ndebug feeds body-parser. Both feed express. express feeds our app.\nAnd package-lock.json writes all of that down.\nThat's why npm can warn us about loops and conflicts.\n\nNow look at public data. The ACS survey feeds a Census estimate,\nwhich feeds a FEMA risk score.\nIs that written down anywhere a computer can read it?\nNo. There's no lock file for data.\n\nOne note: in all these drawings, sources sit at the top and flow down,\nlike a river. Upstream is where things come from.\n\nNEXT: two questions worth asking about any column.", "autoResize": true, "lineHeight": 1.25}, {"id": "98u4hvqyqbxyex8a", "type": "text", "x": 110, "y": 16160, "width": 941.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "9ac4w6z1tk9ajxzu", "roundness": null, "seed": 1184635273, "version": 1, "versionNonce": 1427511155, "isDeleted": false, "boundElements": [], "updated": 1794157960895, "link": null, "locked": false, "text": "You already use one of these", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "You already use one of these", "autoResize": true, "lineHeight": 1.25}, {"id": "s5kybemndijtood1", "type": "rectangle", "x": 330, "y": 16310, "width": 240, "height": 90, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "9ac4w6z1tk9ajxzu", "roundness": {"type": 3}, "seed": 1133163391, "version": 1, "versionNonce": 523983310, "isDeleted": false, "boundElements": [{"type": "text", "id": "gj99fj1mc5y1flit"}, {"type": "arrow", "id": "qrxn6671r3uz4hcj"}, {"type": "arrow", "id": "8iwypq6c24bffcn3"}], "updated": 1794157960895, "link": null, "locked": false}, {"id": "gj99fj1mc5y1flit", "type": "text", "x": 402.0, "y": 16332.5, "width": 96.0, "height": 45.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "9ac4w6z1tk9ajxzu", "roundness": null, "seed": 163622692, "version": 1, "versionNonce": 361232907, "isDeleted": false, "boundElements": [], "updated": 1794157960895, "link": null, "locked": false, "text": "debug", "fontSize": 36, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "s5kybemndijtood1", "originalText": "debug", "autoResize": true, "lineHeight": 1.25}, {"id": "dkhcbukh3kglmwmx", "type": "rectangle", "x": 120, "y": 16500, "width": 280, "height": 90, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "9ac4w6z1tk9ajxzu", "roundness": {"