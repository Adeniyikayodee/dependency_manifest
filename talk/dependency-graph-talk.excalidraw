ype": "text", "x": 683.5, "y": 31640, "width": 553.0, "height": 50.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "gq26d8bom2kfh9hn", "roundness": null, "seed": 802583168, "version": 1, "versionNonce": 1806271386, "isDeleted": false, "boundElements": [], "updated": 1794157960968, "link": null, "locked": false, "text": "~0.1 seconds  \u00b7  no network", "fontSize": 40, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "~0.1 seconds  \u00b7  no network", "autoResize": true, "lineHeight": 1.25}, {"id": "r7z410evlq2522bo", "type": "frame", "x": 0, "y": 32160, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "gq26d8bom2kfh9hn", "roundness": null, "seed": 102848860, "version": 1, "versionNonce": 1738301348, "isDeleted": false, "boundElements": [], "updated": 1794157960968, "link": null, "locked": false, "name": "25 Demo"}, {"id": "3t869atz82dcjjgr", "type": "text", "x": 2000, "y": 32160, "width": 1300.0, "height": 650.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1639732231, "version": 1, "versionNonce": 1998992210, "isDeleted": false, "boundElements": [], "updated": 1794157960975, "link": null, "locked": false, "text": "Notes\n\n[28:00 \u00b7 2 min]\n[LIVE DEMO. Terminal open, font large, already in the repo folder.]\n\nTYPE:\npython3 lint_lineage.py --target FEMA_NRI.risk_score --covariates ACS.EP_POV150 ACS.EP_UNEMP\n\nSAY while it prints:\nFAIL. Two errors. Poverty: one route. Unemployment: two routes.\nThe same two routes we drew by hand.\n\nTYPE: echo $?\nSAY: Exit code 1. In CI, that's a red build.\n\nBONUS: rerun with a typo, EP_UNEMPP. Still FAIL. Typos can't sneak through.\n\n[IF THE DEMO BREAKS] Stay calm: \"This is exactly what it prints.\" Point at the screenshot.\n\nNEXT: time to admit where we got it wrong.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[28:00 \u00b7 2 min]\n[LIVE DEMO. Terminal open, font large, already in the repo folder.]\n\nTYPE:\npython3 lint_lineage.py --target FEMA_NRI.risk_score --covariates ACS.EP_POV150 ACS.EP_UNEMP\n\nSAY while it prints:\nFAIL. Two errors. Poverty: one route. Unemployment: two routes.\nThe same two routes we drew by hand.\n\nTYPE: echo $?\nSAY: Exit code 1. In CI, that's a red build.\n\nBONUS: rerun with a typo, EP_UNEMPP. Still FAIL. Typos can't sneak through.\n\n[IF THE DEMO BREAKS] Stay calm: \"This is exactly what it prints.\" Point at the screenshot.\n\nNEXT: time to admit where we got it wrong.", "autoResize": true, "lineHeight": 1.25}, {"id": "s2k2fa1goasax5wg", "type": "text", "x": 110, "y": 32230, "width": 693.0, "height": 75.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "r7z410evlq2522bo", "roundness": null, "seed": 441350937, "version": 1, "versionNonce": 399307731, "isDeleted": false, "boundElements": [], "updated": 1794157960975, "link": null, "locked": false, "text": "Live: watching it go red", "fontSize": 60, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Live: watching it go red", "autoResize": true, "lineHeight": 1.25}, {"id": "q8we2yg4renwos1z", "type": "image", "x": 110, "y": 32340, "width": 1700, "height": 885.8002406738868, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "r7z410evlq2522bo", "roundness": null, "seed": 440757487, "version": 1, "versionNonce": 173802388, "isDeleted": false, "boundElements": [], "updated": 1794157960977, "link": null, "locked": false, "fileId": "7eb6492aeec34ad929d1d52b30af56f690ec533b", "status": "saved", "scale": [1, 1], "crop": null}, {"id": "ihn0uqc7ww90zxwp", "type": "frame", "x": 0, "y": 33500, "width": 1920, "height": 1080, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "r7z410evlq2522bo", "roundness": null, "seed": 1903366798, "version": 1, "versionNonce": 1437767255, "isDeleted": false, "boundElements": [], "updated": 1794157960977, "link": null, "locked": false, "name": "26 Where we got it wrong"}, {"id": "k36x7xl182rx6kyv", "type": "text", "x": 2000, "y": 33500, "width": 929.0, "height": 585.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 863551072, "version": 1, "versionNonce": 377414922, "isDeleted": false, "boundElements": [], "updated": 1794157960984, "link": null, "locked": false, "text": "Notes\n\n[30:00 \u00b7 1.5 min]\nSAY:\nWe got this wrong ourselves.\n\nThe CDC file has a handful of extra columns that aren't in the score.\nWe marked 8 of them as safe.\n\nTurns out 7 of them add up, exactly, to one of the score's own inputs.\nThe chart on the right: every dot on the line. Zero difference.\nSo they were inside the score all along, just one step removed.\n\nOur own tool would have cleared them. Now it doesn't.\n\nLESSON: read the method, then check it in the data.\n\nNEXT: the graph only helps if we keep it right.", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Notes\n\n[30:00 \u00b7 1.5 min]\nSAY:\nWe got this wrong ourselves.\n\nThe CDC file has a handful of extra columns that aren't in the score.\nWe marked 8 of them as safe.\n\nTurns out 7 of them add up, exactly, to one of the score's own inputs.\nThe chart on the right: every dot on the line. Zero difference.\nSo they were inside the score all along, just one step removed.\n\nOur own tool would have cleared them. Now it doesn't.\n\nLESSON: read the method, then check it in the data.\n\nNEXT: the graph only helps if we keep it right.", "autoResize": true, "lineHeight": 1.25}, {"id": "ooziifct1o7ux6hd", "type": "text", "x": 110, "y": 33580, "width": 634.0, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "ihn0uqc7ww90zxwp", "roundness": null, "seed": 1652161279, "version": 1, "versionNonce": 1410820127, "isDeleted": false, "boundElements": [], "updated": 1794157960984, "link": null, "locked": false, "text": "We got it wrong too", "fontSize": 64, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "We got it wrong too", "autoResize": true, "lineHeight": 1.25}, {"id": "a016tcxnw31ib4zq", "type": "rectangle", "x": 110, "y": 33760, "width": 440, "height": 120, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "ihn0uqc7ww90zxwp", "roundness": {"type": 3}, "seed": 1857678555, "version": 1, "versionNonce": 1520982087, "isDeleted": false, "boundElements": [{"type": "text", "id": "sz0ahia2432sbga4"}, {"type": "arrow", "id": "z0wul83h1roj6072"}], "updated": 1794157960984, "link": null, "locked": false}, {"id": "sz0ahia2432sbga4", "type": "text", "x": 207.0, "y": 33772.5